DB_HOST=localhost
DB_PORT=5432
DB_NAME=ibovespa_analytics
DB_USER=ibovespa_app
DB_PASSWORD=change-me

DB_TEST_NAME=ibovespa_analytics_test
DB_TEST_USER=ibovespa_app
DB_TEST_PASSWORD=change-me

LOG_LEVEL=INFO
PIPELINE_TIMEOUT_SECONDS=120
PIPELINE_MAX_RETRIES=3

# Token da brapi.dev (https://brapi.dev/dashboard) — usado apenas para as
# atualizações diárias incrementais do Ibovespa. Sem este token, essas
# atualizações falham (registradas como erro no pipeline) mas o backfill
# histórico via yfinance continua funcionando normalmente.
BRAPI_API_KEY=change-me

# Origem permitida para CORS (o frontend Vite em desenvolvimento).
FRONTEND_ORIGIN=http://localhost:5173
